# syntax=docker/dockerfile:1
#
# Production image for the React/Vite portal (T-11). Self-contained under
# deploy/ — see deploy/Dockerfile.backend's header comment for why the
# build context is the repo root and what deploy/Dockerfile.portal.
# dockerignore trims out of it.
#
# *** VITE_PORTAL_TOKEN build-time caveat — read before deploying ***
# Vite inlines every `VITE_`-prefixed env var into the built JS bundle at
# `vite build` time (portal/src/api.ts: `import.meta.env.VITE_PORTAL_TOKEN`)
# — there is no runtime env for static-file output to read. That makes
# VITE_PORTAL_TOKEN a Docker BUILD ARG here, not a `docker compose`
# `environment:` entry: setting it as a runtime env var on the `portal`
# container would do nothing, because by the time the container runs, the
# JS has already been built with whatever (or nothing) was present at
# `npm run build` time.
#
# The real security implication: the token ends up in cleartext inside
# the shipped JS bundle, fetchable by anyone who loads the portal page —
# view-source, no auth required. That's acceptable ONLY because SPEC's
# non-goals explicitly scope this to "no real portal auth (single shared
# token)" for a demo deployment; it would NOT be acceptable for a token
# that guarded anything beyond this project's single-shared-secret portal.
# Rotate PORTAL_TOKEN (both backend env and this build arg, then rebuild
# the portal image — a token change never takes effect without a rebuild)
# if the droplet is ever exposed somewhere the demo audience isn't fully
# trusted with API access.

FROM node:22-alpine AS build

WORKDIR /app

# Dependency install first, isolated from source changes.
COPY portal/package.json portal/package-lock.json ./
RUN npm ci

COPY portal/ ./

# See the file-level caveat above: this is a build arg, consumed only
# during `npm run build` (tsc --noEmit && vite build), never at runtime.
ARG VITE_PORTAL_TOKEN=""
ENV VITE_PORTAL_TOKEN=${VITE_PORTAL_TOKEN}
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY deploy/portal/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=5s --timeout=3s --retries=20 --start-period=10s \
    CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1
