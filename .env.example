# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# --- Postgres (docker-compose service `db`) ---
POSTGRES_USER=othram
POSTGRES_PASSWORD=othram
POSTGRES_DB=othram
POSTGRES_PORT=5432
DATABASE_URL=postgresql://othram:othram@localhost:5432/othram

# --- Redis / arq job queue (W1-A + W1-F1, ADR-002) ---
# Broker only. Postgres stays the system of record; nothing else uses Redis.
# The queue name (`cxforge:jobs`) and the arq task name (`run_ticket`) are
# frozen contracts in docs/DESIGN.md §1.1 and live in code, not here.
#
# The value below is the LOCAL-DEV one: a host-run `uvicorn main:app` or
# `arq worker.main.WorkerSettings` talks to the redis container through its
# published host port. Inside either compose stack the containers get
# `redis://redis:6379/0` instead (the compose service name, resolved on the
# compose network) — see the `REDIS_URL` line on each app service.
REDIS_URL=redis://localhost:6379/0

# --- Model / embedding credentials ---
# ANTHROPIC_API_KEY is resolved by the Anthropic SDK, not by any os.environ
# read in this repo — exactly the class of variable that went missing for
# weeks (docs/STATE.md §6.2) — so it is pinned in test_env_forwarding.py's
# SDK_RESOLVED_VARIABLES and required in every application container.
# Model version is pinned in backend/src/agent/config.py, not here.
ANTHROPIC_API_KEY=
# Voyage embeddings (ADR-008, voyage-4-lite @ output_dimension=1024). Read
# directly by backend/src/data/embeddings.py (an httpx client, not the
# `voyageai` SDK), so the AST scan requires it in every container too.
# Required whenever KB_EMBEDDER=voyage; VoyageEmbedder refuses to build
# without it rather than degrading to the lexical embedder.
VOYAGE_API_KEY=

# --- Which embedder the KB is seeded and searched with (ADR-008) ---
# `hashing` (the default) is the deterministic, fully offline lexical
# embedder. `voyage` is the real semantic one. Nothing else is accepted — a
# typo raises rather than quietly falling back.
#
# DO NOT FLIP THIS ON ITS OWN. `data.seed.seed_all` and
# `data.retrieval.search_kb` both resolve their embedder through
# `default_embedder()`, so changing this changes BOTH the vectors that get
# stored and the vectors queries are turned into. Vectors already in
# `kb_chunks` were produced by the previous embedder and are not in the same
# space as the new query vectors, so a flip without a reseed does not error —
# it returns confident, plausible, wrong passages. Flip it and reseed the KB
# in the same maintenance window, with no worker consuming jobs (see
# SEED_ON_START below and docs/BUILD-PLAN.md §10.3).
#
# It is deliberately NOT "use Voyage if VOYAGE_API_KEY is set": this repo's
# real .env carries the key, and that rule would put the offline `-m "not
# live"` suite on the network the moment anyone ran `set -a; source .env`.
KB_EMBEDDER=hashing

# --- Zendesk (OAuth 2.0 only — API tokens are deprecated, never use them) ---
# Filled in by following docs/zendesk-runbook.md (T-4).
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_CLIENT_ID=
# Must EXACTLY match a URL registered on the OAuth client's 'Redirect URLs'.
# Blank = http://localhost:8129/callback (what the runbook says to register).
ZENDESK_OAUTH_REDIRECT_URI=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_TOKEN=
ZENDESK_WEBHOOK_SIGNING_SECRET=
# User id of the dedicated AI agent user, for self-event drop in ingress.
ZENDESK_AI_USER_ID=
# Optional. Only read by scripts/live_smoke.py, to exercise assign_group.
ZENDESK_LIVE_SMOKE_GROUP_ID=

# --- Portal ---
PORTAL_TOKEN=dev-portal-token

# --- Published host ports (compose only; no application code reads these) ---
# Every ${VAR} either compose file interpolates must have a line in this file —
# backend/tests/deploy/test_env_forwarding.py asserts it, so a new
# `${SOMETHING:-default}` in a compose file cannot stay undocumented.
# Override any of these if the default collides with something on the droplet.
BACKEND_PORT=8000
PORTAL_PORT=8080
REDIS_PORT=6379

# --- Deploy-time DB bootstrap (deploy/backend/bootstrap.py) ---
# Read by the backend container's entrypoint on EVERY start, including every
# restart. Three modes:
#
#   true (default) — create the schema, then seed cases/kb_chunks from
#                    fixtures/ ONLY IF both tables are empty. A fresh deploy
#                    comes up demo-able; a restart of a populated database is
#                    left alone. Safe to run repeatedly, which matters because
#                    `restart: unless-stopped` means it WILL run repeatedly.
#   false          — create the schema and stop.
#   force          — seed unconditionally, TRUNCATE-ing cases/kb_chunks. Only
#                    do this when no worker is running: seed_all() empties both
#                    tables before reloading, and a retrieval in flight would
#                    see an empty knowledge base.
#
# Never touches runs/drafts/settings in any mode. An unrecognised value means
# `true`, so a typo can never truncate anything.
SEED_ON_START=true

# --- Langfuse tracing (optional in dev) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Cloudflare named tunnel (W1-F2, ADR-005) ---
# OA-3 is DONE. The real (gitignored) .env has both of these populated, and
# cxforge.hankholcomb.com resolves to Cloudflare. Still UNVERIFIED end to end:
# measured 2026-08-16 the edge returns 502, because the cloudflared service has
# never been started. See deploy/cloudflared/README.md. They stay empty HERE —
# this file is committed.
#
# CLOUDFLARE_TUNNEL_TOKEN is the long `eyJ...` string Cloudflare shows when
# you create a *named* tunnel (Zero Trust -> Networks -> Tunnels). It is a
# credential: it alone lets a process serve traffic for your hostname. Never
# commit it, never bake it into an image.
#
# `deploy/docker-compose.yml` reads it as `${CLOUDFLARE_TUNNEL_TOKEN}` with
# NO `:-` default on purpose. A `:-` default would render an empty string and
# start a cloudflared that quietly serves nothing; with no default, compose
# prints a "variable is not set" warning and cloudflared exits non-zero on
# startup, so the failure is visible in `docker compose ps`.
CLOUDFLARE_TUNNEL_TOKEN=
# The public origin the tunnel terminates at, e.g. https://cxforge.example.com
# (OA-3 step 4). Nothing in the app reads this yet — it is the single place
# the hostname is written down, and the Zendesk webhook endpoint is
# ${PUBLIC_BASE_URL}/webhooks/zendesk. See deploy/cloudflared/README.md.
PUBLIC_BASE_URL=

# --- DigitalOcean (T-11 deploy) ---
# doctl does NOT read this file. To make it visible to doctl:
#     set -a; source .env; set +a
# which exports it under the name doctl reads natively.
# Alternatively run `doctl auth init` in a real terminal and skip this entirely.
DIGITALOCEAN_ACCESS_TOKEN=
# Droplet hostname or IP once created — used by scripts/verify_deploy.sh.
# Precedence: an already-exported DEPLOY_HOST in your shell ALWAYS wins
# over this line — sourcing .env can never clobber it. This line only
# takes effect when the shell does not already have DEPLOY_HOST exported.
# Leaving this empty is fine, but note it means REMOTE mode is off: with
# no --local flag, scripts/verify_deploy.sh now HARD FAILS (exit non-zero,
# no PASS) rather than silently falling back to a local docker-compose
# check. Pass --local yourself if you want that local-only check; it is
# never droplet evidence.
DEPLOY_HOST=

# --- Deep deploy check (W3-G2, scripts/verify_core_loop.py) ---
# Read ONLY by `bash scripts/verify_deploy.sh --deep`. Nothing in the
# application reads either of these, and neither belongs in any compose file.
#
# The id of a DISPOSABLE helpdesk ticket the DEPLOYED agent can really fetch.
# It cannot be invented: agent.nodes.ingest's first statement is
# port.fetch_ticket(), so a made-up id 404s and the run dies before any `runs`
# row exists — the check would then fail identically whether or not the core
# loop is connected, which is the exact ambiguity it exists to remove.
# Uniqueness per invocation comes from a fresh comment_id plus a baseline of
# existing run ids, not from this value, so the same ticket is meant to be
# reused. Expect the agent to post a real public reply on it.
CXFORGE_VERIFY_TICKET_ID=
# The database of the DEPLOYMENT UNDER TEST, used only to delete the rows the
# check itself created and to print the raw `runs` row it asserted on.
# Deliberately NOT defaulted from DATABASE_URL: in REMOTE mode DATABASE_URL
# names your own dev Postgres on localhost, not the droplet's, so a fallback
# would aim the cleanup DELETEs at the wrong database entirely. Leave empty
# when the deployment's Postgres is unreachable (the droplet publishes no
# host port for it) — the check then prints the exact SQL and says out loud
# that it left its rows behind.
CXFORGE_VERIFY_DB_URL=

# --- Test harness ---
# Set to 1 to skip tests that require the docker-compose Postgres (CI sets this).
SKIP_DB_TESTS=0
