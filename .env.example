# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# --- Postgres (docker-compose service `db`) ---
POSTGRES_USER=othram
POSTGRES_PASSWORD=othram
POSTGRES_DB=othram
POSTGRES_PORT=5432
DATABASE_URL=postgresql://othram:othram@localhost:5432/othram

# --- OpenAI (behind LLMClient; model version pinned in config, not here) ---
OPENAI_API_KEY=

# --- Zendesk (OAuth 2.0 only — API tokens are deprecated, never use them) ---
# Filled in by following docs/zendesk-runbook.md (T-4).
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_TOKEN=
ZENDESK_WEBHOOK_SIGNING_SECRET=
# User id of the dedicated AI agent user, for self-event drop in ingress.
ZENDESK_AI_USER_ID=

# --- Portal ---
PORTAL_TOKEN=dev-portal-token

# --- Langfuse tracing (optional in dev) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Test harness ---
# Set to 1 to skip tests that require the docker-compose Postgres (CI sets this).
SKIP_DB_TESTS=0
