+    label: str, verify: str, scope: list[str], expected: list[str]
+) -> None:
+    """One table, both directions: every shape that must be refused, and every
+    near-miss that must not be. A rule that only ever fires is useless here --
+    it would refuse 31 of the plan's 32 tickets."""
+    got = [p for p, _glob in harness.self_gating_data_reads(_ticket(verify, scope))]
+    assert got == expected, (
+        f"{label}: expected flagged paths {expected}, got {got} for verify {verify!r} "
+        f"against scope {scope!r}"
+    )
+
+
+def test_a_flagged_hit_names_the_scope_glob_that_grants_the_write() -> None:
+    """The refusal has to tell a human WHICH scope entry closes the loop --
+    that is the line the plan amendment has to change."""
+    hits = harness.self_gating_data_reads(_ticket(T7_SHIPPED_APPROVAL_CLAUSE, T7_SHIPPED_SCOPE))
+    assert hits == [("evals/labeled_set.yaml", "evals/**")]
