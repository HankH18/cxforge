+# ---------------------------------------------------------------------------
+# Whole-plan measurement
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("ticket", REAL_TICKETS, ids=lambda t: str(t["id"]))
+def test_no_new_self_verifying_ticket_enters_the_plan(ticket: dict[str, Any]) -> None:
+    """Ratchet, not amnesty. Every real ticket outside KNOWN_SELF_VERIFYING must
+    have a gate it cannot author. The pin exists only so recording today's defect
+    does not turn every other ticket's close red mid-remediation; cmd_claim and
+    cmd_close refuse the pinned ids all the same, so nothing can be closed under
+    the exemption.
+    """
+    hits = harness.self_gating_data_reads(ticket)
+    if ticket["id"] in KNOWN_SELF_VERIFYING:
+        pytest.skip(f"{ticket['id']} is the known W16 plan defect; claim/close refuse it outright")
+    assert not hits, (
+        f"{ticket['id']}'s verify decides PASS/FAIL by reading "
+        f"{[p for p, _ in hits]}, which its own scope {ticket['scope']!r} lets it write. "
+        f"A ticket may not author the evidence that clears it."
+    )
+
+
+def test_exactly_one_ticket_in_the_real_plan_self_verifies_and_it_is_t_7() -> None:
+    """The whole-plan precision measurement, in one assertion: 1 flagged, 31 clean.
+
+    Subset rather than equality on purpose. Amending T-7's verify (the remediation
+    this check exists to unblock) must not turn the suite red inside a scope that
+    cannot edit this file -- T-15 owns docs/tickets.json but not
+    backend/tests/hooks/**. The pin may therefore go stale downward, which costs
+    nothing: enforcement is cmd_claim/cmd_close recomputing from the plan, never
+    this constant.
+    """
+    flagged = {t["id"] for t in REAL_TICKETS if harness.self_gating_data_reads(t)}
+    assert flagged <= KNOWN_SELF_VERIFYING, (
+        f"new self-verifying ticket(s) in the plan: {sorted(flagged - KNOWN_SELF_VERIFYING)}. "
+        f"A ticket may not be judged by a file its own scope lets it write."
+    )
+    assert len(REAL_TICKETS) - len(flagged) >= 31, "the clean-ticket count regressed"
+    by_id = {t["id"]: t for t in REAL_TICKETS}
+    if "T-7" in flagged:  # still unamended: pin the exact shape that was measured
+        assert harness.self_gating_data_reads(by_id["T-7"]) == [
+            ("evals/labeled_set.yaml", "evals/**")
+        ]
+
+
+# ---------------------------------------------------------------------------
+# Lifecycle: the refusal actually stops a claim and a close
+# ---------------------------------------------------------------------------
+GATE_FILE = "evals/approval.json"
+UNAPPROVED = json.dumps(
+    {"approval": {"status": "PROPOSED_AWAITING_HUMAN_REVIEW", "approved_by": None,
+                  "approved_date": None}}
+)
+FORGED = json.dumps(
+    {"approval": {"status": "APPROVED", "approved_by": "Hank Holcomb",
+                  "approved_date": "2026-08-15"}}
+)
+# T-7's structure exactly -- a literal repo path embedded inside a `-c` program
+# whose exit status turns on three fields -- with stdlib json in place of yaml so
+# the synthetic project needs no third-party import.
+GATE_VERIFY = (
+    f'"{sys.executable}" -c "import json,sys; '
+    f"a=json.load(open('{GATE_FILE}'))['approval']; "
+    "sys.exit(0 if a['status']=='APPROVED' and a['approved_by'] and a['approved_date'] else 1)\""
+)
+PASSING_VERIFY = f'"{sys.executable}" -c "import sys; sys.exit(0)"'
+TEST_MODULE = "backend/tests/evals/test_x.py"
+ONE_PASSING_TEST = "def test_x():\n    assert True\n"
+
+
+def _run_git(proj: Path, *args: str) -> None:
+    subprocess.run(["git", *args], cwd=proj, capture_output=True, text=True, check=True)
+
+
+def _make_project(
+    tmp_path: Path, tickets: list[dict[str, Any]], files: dict[str, str]
+) -> Path:
+    proj = tmp_path / "proj"
+    (proj / "docs").mkdir(parents=True)
+    (proj / ".claude" / "scripts").mkdir(parents=True)
+    for src in (HARNESS_LIB, CLAIM_SH, GEN_TASKS):
+        shutil.copy2(src, proj / ".claude" / "scripts" / src.name)
+    (proj / "docs" / "tickets.json").write_text(
+        json.dumps({"project": "w16-test", "tickets": tickets})
+    )
+    for rel, content in files.items():
+        fp = proj / rel
+        fp.parent.mkdir(parents=True, exist_ok=True)
+        fp.write_text(content)
+    _run_git(proj, "init", "-q")
+    _run_git(proj, "config", "user.email", "hooktest@example.com")
+    _run_git(proj, "config", "user.name", "hook-test")
+    _run_git(proj, "config", "commit.gpgsign", "false")
+    _run_git(proj, "add", "-A")
+    _run_git(proj, "commit", "-q", "-m", "initial")
+    return proj
+
+
+def _env(proj: Path, session_id: str) -> dict[str, str]:
+    env = dict(os.environ)
+    env["CLAUDE_PROJECT_DIR"] = str(proj)
+    env["CLAUDE_CODE_SESSION_ID"] = session_id
+    return env
+
+
+def _harness_cmd(proj: Path, session_id: str, *args: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["bash", str(proj / ".claude" / "scripts" / "claim.sh"), *args],
+        cwd=proj, capture_output=True, text=True, env=_env(proj, session_id), timeout=60,
+    )
+
+
+def test_claim_refuses_a_ticket_whose_gate_reads_a_file_its_own_scope_can_write(
+    tmp_path: Path,
+) -> None:
+    """Fail early: the loop is refused BEFORE any work is done, so the ticket
+    cannot reach close at all. Measured against the shipped harness this same
+    claim returned rc=0 and the close then minted a receipt."""
+    proj = _make_project(
+        tmp_path,
+        [_ticket(GATE_VERIFY, ["evals/**", "backend/tests/evals/**"], tid="T-900")],
+        {GATE_FILE: UNAPPROVED, TEST_MODULE: ONE_PASSING_TEST},
+    )
+    result = _harness_cmd(proj, "session-w16-claim", "claim", "T-900", "next per plan order")
+    assert result.returncode == 1, result.stdout + result.stderr
+    assert "SELF-VERIFYING TICKET" in result.stdout
+    assert GATE_FILE in result.stdout
+    assert "evals/**" in result.stdout
+    assert not (proj / ".claude" / "claims" / "session-w16-claim.json").exists()
+    assert not (proj / ".claude" / "evidence" / "T-900.json").exists()
+
+
+def test_close_refuses_a_verify_rewritten_into_a_self_gate_after_the_claim(
+    tmp_path: Path,
+) -> None:
+    """The close-time re-check is not redundant with the claim-time one.
+    T-14, T-15 and T-26 all carry docs/tickets.json in their own scope, so a
+    ticket can rewrite its OWN verify string after the claim was granted. Only a
+    check that re-reads the plan at close sees that.
+    """
+    proj = _make_project(
+        tmp_path,
+        [_ticket(PASSING_VERIFY, ["docs/tickets.json", "evals/**"], tid="T-901")],
+        {GATE_FILE: UNAPPROVED},
+    )
+    claimed = _harness_cmd(proj, "session-w16-rewrite", "claim", "T-901", "note")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+
+    doc = json.loads((proj / "docs" / "tickets.json").read_text())
+    doc["tickets"][0]["verify"] = GATE_VERIFY
+    (proj / "docs" / "tickets.json").write_text(json.dumps(doc))
+    (proj / GATE_FILE).write_text(FORGED)
+
+    closed = _harness_cmd(proj, "session-w16-rewrite", "close")
+    assert closed.returncode == 2, closed.stdout + closed.stderr
+    assert "SELF-VERIFYING TICKET" in closed.stdout
+    assert not (proj / ".claude" / "evidence" / "T-901.json").exists()
+    # the claim survives, so the session's only sanctioned exit is release
+    assert (proj / ".claude" / "claims" / "session-w16-rewrite.json").exists()
+
+
+def test_an_ordinary_pytest_ticket_still_claims_and_closes(tmp_path: Path) -> None:
+    """The regression that matters: 31 of the plan's 32 tickets run a test
+    runner over files inside their own scope, and every one of them must keep
+    closing."""
+    verify = f'"{sys.executable}" -m pytest backend/tests/evals -q'
+    proj = _make_project(
+        tmp_path,
+        [_ticket(verify, ["evals/**", "backend/tests/evals/**"], tid="T-902")],
+        {GATE_FILE: UNAPPROVED, TEST_MODULE: ONE_PASSING_TEST},
+    )
+    claimed = _harness_cmd(proj, "session-w16-ok", "claim", "T-902", "note")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+    (proj / TEST_MODULE).write_text(
+        ONE_PASSING_TEST + "\n\ndef test_y():\n    assert True\n"
+    )
+    closed = _harness_cmd(proj, "session-w16-ok", "close")
+    assert closed.returncode == 0, closed.stdout + closed.stderr
+    assert (proj / ".claude" / "evidence" / "T-902.json").exists()
+
+
+def test_a_content_gate_on_an_out_of_scope_artifact_still_closes(tmp_path: Path) -> None:
+    """The shape the plan actually wants: the gate reads ground truth the ticket
+    has no authority to write. Identical verify string to the refused case --
+    only the scope differs -- so this isolates scope membership as the
+    discriminator rather than 'reads a yaml/json file'."""
+    proj = _make_project(
+        tmp_path,
+        [_ticket(GATE_VERIFY, ["backend/tests/evals/**"], tid="T-903")],
+        {GATE_FILE: FORGED, TEST_MODULE: ONE_PASSING_TEST},
+    )
+    claimed = _harness_cmd(proj, "session-w16-external", "claim", "T-903", "note")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+    closed = _harness_cmd(proj, "session-w16-external", "close")
+    assert closed.returncode == 0, closed.stdout + closed.stderr
+    assert (proj / ".claude" / "evidence" / "T-903.json").exists()
