+        "npx promptfoo eval -c promptfooconfig.yaml",
+        ["promptfooconfig.yaml"],
+        ["promptfooconfig.yaml"],
+    ),
+    # --- (1)+(2) but NOT (3): the file is outside the ticket's own scope ------
+    (
+        "the same content gate on an out-of-scope file is external ground truth",
