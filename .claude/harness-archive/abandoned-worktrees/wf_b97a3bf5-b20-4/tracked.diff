+
+# ---------------------------------------------------------------------------
+# Unit level: what the rule flags, and -- more importantly -- what it does not
+# ---------------------------------------------------------------------------
+def _ticket(verify: str, scope: list[str], tid: str = "T-900") -> dict[str, Any]:
+    return {"id": tid, "title": "synthetic", "scope": scope, "verify": verify, "depends_on": []}
+
+
+# (label, verify, scope, expected flagged paths)
+PRECISION_CASES: list[tuple[str, str, list[str], list[str]]] = [
+    # --- the true positive, in every spelling the attack can take -------------
+    (
+        "T-7's shipped clause, verbatim",
+        T7_SHIPPED_APPROVAL_CLAUSE,
+        T7_SHIPPED_SCOPE,
+        ["evals/labeled_set.yaml"],
+    ),
+    (
+        "same read via grep instead of python",
+        "grep -q 'status: APPROVED' evals/labeled_set.yaml",
+        ["evals/**"],
+        ["evals/labeled_set.yaml"],
+    ),
+    (
+        "same read, spelled with a leading ./",
+        "grep -q APPROVED ./evals/labeled_set.yaml",
+        ["evals/**"],
+        ["evals/labeled_set.yaml"],
+    ),
+    (
+        "gate file named by a single-file scope entry, not a glob",
+        "python -c \"import json,sys; sys.exit(0 if json.load(open('evals/approval.json'))"
+        "['ok'] else 1)\"",
+        ["evals/approval.json", "backend/tests/evals/**"],
+        ["evals/approval.json"],
+    ),
+    (
