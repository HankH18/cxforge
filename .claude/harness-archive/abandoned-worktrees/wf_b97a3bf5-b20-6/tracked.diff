diff --git a/backend/tests/hooks/test_supersede_terminal_state.py b/backend/tests/hooks/test_supersede_terminal_state.py
new file mode 100644
index 0000000..d52899e
--- /dev/null
+++ b/backend/tests/hooks/test_supersede_terminal_state.py
@@ -0,0 +1,452 @@
+"""W8: the harness's THIRD terminal state — "worked, and verified unachievable".
+
+THE DEFECT. Before this, `.claude/scripts/harness_lib.py` offered exactly two
+terminal outcomes for a ticket:
+
+  * `close`  -> mints `.claude/evidence/<id>.json`, a receipt. A receipt asserts the
+    verify command ran and passed against a fingerprinted tree, so it cannot express
+    "this cannot be done".
+  * `release` -> asserts nothing, writes no evidence, and leaves the ticket deriving
+    `queue`. Every ticket that `depends_on` it then stays permanently unclaimable
+    ("blocked: dependency <id> has no receipt").
+
+So a session that worked a ticket and established its acceptance was unachievable as
+specified had no honest exit that unblocked the graph. The only move that did was to
+mint a receipt for work that had not been done. That is not hypothetical: T-28's own
+shipped test file states in capitals that its acceptance is NOT met, and T-28 has a
+fingerprint-bound receipt. `test_reproduces_the_two_state_squeeze` below drives that
+whole squeeze end to end against a real synthetic project, so the pressure this state
+relieves is asserted, not merely described.
+
+THE FIX, and the property these tests actually defend. A superseded record must be
+**structurally impossible to mistake for a verified receipt**, at every site that
+reads evidence — not just at the one that writes it. The two kinds partition
+`.claude/evidence/`:
+
+  * `receipt(tid)` returns a record ONLY when it is a receipt. It returns None for a
+    superseded record and for any record whose `kind` the harness does not recognise.
+    Every `if receipt(tid)` in the harness means "was this VERIFIED", and there are
+    four of them: `status()`, the re-claim refusal, the `depends_on` gate, and the
+    task gate. Each is covered below.
+  * `superseded(tid)` returns a record ONLY when it is a supersede.
+
+ON-DISK ASYMMETRY, deliberate and pinned by `test_a_receipt_carries_no_kind_field`:
+only the superseded record carries `"kind"`. Receipts do not, because every receipt
+minted before the discriminator existed lacks the field (28 are live in this repo), so
+`evidence_kind()` must read ABSENCE as "receipt" forever. Given that, stamping new
+receipts would add no safety at all — the guarantee lives entirely in `evidence_kind()`
+failing CLOSED on any kind it does not positively recognise — while splitting the
+receipt population into two shapes and mutating the harness's own attestation artifact.
+`test_an_unrecognised_kind_is_never_a_receipt` is the test that makes the fail-closed
+half real; without it, "absence means receipt" would be one typo away from certifying.
+
+Every test builds its own disposable project in `tmp_path` via this package's
+`conftest.make_project` (real `.claude/scripts/` + `.claude/hooks/` copied in, real git
+history, `CLAUDE_PROJECT_DIR` pointed at the copy). The real repo's `.claude/claims/`,
+`.claude/evidence/` and git history are never touched — `conftest`'s
+`_assert_real_repo_untouched` trip-wire enforces that for the whole module.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from .conftest import make_project
+
+REASON = (
+    "acceptance 2 requires a live Anthropic API key inside the close gate, "
+    "so it cannot be met offline or in CI as specified"
+)
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+def _ticket(tid: str, scope: list[str], *, verify: str = "true",
+            depends_on: list[str] | None = None) -> dict:
+    return {
+        "id": tid,
+        "title": f"synthetic {tid}",
+        "objective": "exercise the supersede terminal state",
+        "acceptance": ["n/a"],
+        "verify": verify,
+        "scope": scope,
+        "depends_on": depends_on or [],
+        "non_goals": [],
+        "parallel_safe": False,
+        "status": "open",
+    }
+
+
+def _harness(root: Path, args: list[str], *, session: str | None = "sess-a",
+             stdin: str | None = None) -> subprocess.CompletedProcess[str]:
+    env = dict(os.environ)
+    env["CLAUDE_PROJECT_DIR"] = str(root)
+    if session is None:
+        env.pop("CLAUDE_CODE_SESSION_ID", None)
+    else:
+        env["CLAUDE_CODE_SESSION_ID"] = session
+    return subprocess.run(
+        [sys.executable, str(root / ".claude" / "scripts" / "harness_lib.py"), *args],
+        input=stdin, capture_output=True, text=True, env=env, cwd=root, timeout=60,
+    )
+
+
+def _board(root: Path) -> dict[str, str]:
+    result = _harness(root, ["status_board"], session=None)
+    assert result.returncode == 0, result.stderr
+    out = {}
+    for line in result.stdout.splitlines():
+        parts = line.split()
+        if parts and parts[0].startswith("T-"):
+            out[parts[0]] = parts[1]
+    return out
+
+
+def _project(tmp_path: Path, tickets: list[dict], files: dict[str, str]) -> Path:
+    root = make_project(tmp_path, {"project": "supersede-probe", "tickets": tickets})
+    for rel, content in files.items():
+        p = root / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(content)
+    subprocess.run(["git", "add", "-A"], cwd=root, check=True, capture_output=True)
+    subprocess.run(["git", "commit", "-q", "-m", "scope files"], cwd=root, check=True,
+                   capture_output=True)
+    return root
+
+
+def _superseded_pair(tmp_path: Path) -> Path:
+    """T-101 superseded, T-102 depends on it. The state most tests start from."""
+    root = _project(
+        tmp_path,
+        [_ticket("T-101", ["src/a/**"], verify="test -f src/a/DONE"),
+         _ticket("T-102", ["src/b.py"], depends_on=["T-101"])],
+        {"src/a/a.py": "a\n", "src/b.py": "b\n"},
+    )
+    assert _harness(root, ["claim", "T-101", "first ready ticket"]).returncode == 0
+    result = _harness(root, ["supersede", REASON])
+    assert result.returncode == 0, result.stdout + result.stderr
+    return root
+
+
+# ---------------------------------------------------------------------------
+# 0. the defect itself
+# ---------------------------------------------------------------------------
+def test_reproduces_the_two_state_squeeze(tmp_path: Path) -> None:
+    """The pressure that produced T-28's false receipt, asserted end to end.
+
+    Without a third state: the verify cannot pass, `release` is the only honest exit,
+    and it leaves every dependent permanently blocked -- so the ONLY move that unblocks
+    the graph is to mint a receipt. This test does not assert the old broken behaviour
+    (that would pin the defect); it asserts the two facts that create the squeeze and
+    that remain true today, so the motivation cannot silently evaporate.
+    """
+    root = _project(
+        tmp_path,
+        [_ticket("T-101", ["src/a/**"], verify="test -f src/a/DONE"),
+         _ticket("T-102", ["src/b.py"], depends_on=["T-101"])],
+        {"src/a/a.py": "a\n", "src/b.py": "b\n"},
+    )
+    assert _harness(root, ["claim", "T-101", "first ready ticket"]).returncode == 0
+
+    # (a) close cannot express "unachievable" -- it only reports a failed verify.
+    closed = _harness(root, ["close"])
+    assert closed.returncode == 2
+    assert "VERIFY FAIL" in closed.stdout
+
+    # (b) release asserts nothing and returns the ticket to the queue...
+    assert _harness(root, ["release", "unachievable as specified"]).returncode == 0
+    assert _board(root)["T-101"] == "queue"
+
+    # ...which leaves the dependent permanently unclaimable. A receipt was, before
+    # supersede existed, the only artifact that could clear this.
+    blocked = _harness(root, ["claim", "T-102", "downstream"], session="sess-b")
+    assert blocked.returncode == 1
+    assert "dependency T-101 has no receipt" in blocked.stdout
+
+
+# ---------------------------------------------------------------------------
+# 1. the record itself
+# ---------------------------------------------------------------------------
+def test_supersede_writes_a_kind_discriminated_record_with_no_attestation(
+    tmp_path: Path,
+) -> None:
+    """The record must carry `kind`, the reason and the commit -- and must NOT carry
+    `verify` or `fingerprint`. Those two fields are what a receipt uses to assert "this
+    exact tree passed this exact command"; putting either on a record where nothing ran
+    is the single most direct way to make a supersede read as a receipt."""
+    root = _superseded_pair(tmp_path)
+    rec = json.loads((root / ".claude" / "evidence" / "T-101.json").read_text())
+
+    assert rec["kind"] == "superseded"
+    assert rec["ticket"] == "T-101"
+    assert rec["reason"] == REASON
+    assert rec["verified"] is False
+    assert rec["needs_human"] is True
+    assert isinstance(rec["commit"], str) and len(rec["commit"]) == 40
+    assert "verify" not in rec, "a superseded record must not carry a verify command"
+    assert "fingerprint" not in rec, (
+        "a superseded record must not carry a fingerprint -- there is no verified tree "
+        "to bind to, and a fingerprint is exactly what a reader would mistake for one"
+    )
+
+    # The commit it names is real, and is the supersede commit.
+    subject = subprocess.run(
+        ["git", "log", "-1", "--format=%s", rec["commit"]],
+        cwd=root, capture_output=True, text=True, check=True,
+    ).stdout.strip()
+    assert subject == "ticket-supersede: T-101"
+
+
+def test_a_receipt_carries_no_kind_field_so_absence_means_receipt(tmp_path: Path) -> None:
+    """Pins the deliberate on-disk asymmetry (see module docstring): `close` leaves the
+    receipt schema byte-identical to what it was before this change, because 28 legacy
+    receipts with no `kind` must keep reading as receipts forever anyway."""
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    assert _harness(root, ["claim", "T-101", "ordering note"]).returncode == 0
+    assert _harness(root, ["close"]).returncode == 0
+
+    rec = json.loads((root / ".claude" / "evidence" / "T-101.json").read_text())
+    assert "kind" not in rec
+    assert rec.keys() == {"ticket", "session", "verify", "commit", "fingerprint", "attempts", "ts"}
+    assert _board(root)["T-101"] == "resolved"
+
+
+# ---------------------------------------------------------------------------
+# 2. it never reads as a receipt -- one test per `if receipt(tid)` call site
+# ---------------------------------------------------------------------------
+def test_receipt_returns_none_and_status_says_superseded(tmp_path: Path) -> None:
+    """Call site 1 of 4: `status()`. Also the readers themselves, called directly."""
+    root = _superseded_pair(tmp_path)
+    code = (
+        "import sys, json; "
+        f"sys.path.insert(0, {str(root / '.claude' / 'scripts')!r}); "
+        "import harness_lib as H; "
+        "print(json.dumps({'receipt': H.receipt('T-101'), "
+        "'superseded': H.superseded('T-101') is not None, "
+        "'kind': H.evidence_kind(H.evidence('T-101')), "
+        "'status': H.status('T-101')}))"
+    )
+    env = dict(os.environ)
+    env["CLAUDE_PROJECT_DIR"] = str(root)
+    result = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True,
+                            env=env, cwd=root, timeout=60)
+    assert result.returncode == 0, result.stderr
+    got = json.loads(result.stdout)
+
+    assert got["receipt"] is None, "receipt() must never return a superseded record"
+    assert got["superseded"] is True
+    assert got["kind"] == "superseded"
+    assert got["status"] == "superseded"
+    assert _board(root)["T-101"] == "superseded"
+
+
+def test_a_superseded_ticket_cannot_be_reclaimed_and_the_refusal_is_distinct(
+    tmp_path: Path,
+) -> None:
+    """Call site 2 of 4: the re-claim refusal. Both kinds are terminal, but they must
+    not share a sentence -- "already has a receipt" said of a superseded ticket is the
+    exact conflation this discriminator exists to prevent."""
+    root = _superseded_pair(tmp_path)
+    result = _harness(root, ["claim", "T-101", "retry"], session="sess-x")
+
+    assert result.returncode == 1
+    assert "SUPERSEDED" in result.stdout
+    assert "already has a receipt" not in result.stdout
+    assert REASON in result.stdout, "the refusal must carry the recorded reason"
+
+
+def test_a_superseded_dependency_unblocks_dependents_but_warns_loudly(
+    tmp_path: Path,
+) -> None:
+    """Call site 3 of 4: the `depends_on` gate. This is the ONE place a superseded
+    record is allowed to substitute for a receipt -- without it the graph deadlocks and
+    a false receipt is the only escape -- so the substitution has to be audible."""
+    root = _superseded_pair(tmp_path)
+    result = _harness(root, ["claim", "T-102", "downstream"], session="sess-b")
+
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert "claimed T-102" in result.stdout
+    assert "WARNING" in result.stdout
+    assert "SUPERSEDED" in result.stdout
+    assert "T-101" in result.stdout
+
+
+def test_the_task_gate_refuses_to_mark_a_superseded_ticket_completed(
+    tmp_path: Path,
+) -> None:
+    """Call site 4 of 4: `hook-taskgate`. The mirror is what a human skims, so letting
+    "superseded" satisfy the completion gate would put the conflation on the one
+    surface most likely to be believed. Non-completed statuses still pass untouched, so
+    the mirror is not wedged."""
+    root = _superseded_pair(tmp_path)
+
+    blocked = _harness(root, ["hook-taskgate"], stdin=json.dumps(
+        {"tool_input": {"subject": "T-101: synthetic T-101", "status": "completed"}}))
+    assert blocked.returncode == 2
+    assert "SUPERSEDED" in blocked.stderr
+    assert "not completed" in blocked.stderr
+
+    allowed = _harness(root, ["hook-taskgate"], stdin=json.dumps(
+        {"tool_input": {"subject": "T-101: synthetic T-101", "status": "cancelled"}}))
+    assert allowed.returncode == 0
+
+
+def test_close_refuses_to_mint_a_receipt_over_a_superseded_record(tmp_path: Path) -> None:
+    """Belt-and-braces on the write side: promoting "unachievable" to "verified" by
+    overwriting the record is the worst single outcome available here, so `close`
+    refuses even though `claim` already makes it unreachable."""
+    root = _superseded_pair(tmp_path)
+    # Fabricate the unreachable state: a live claim on an already-superseded ticket.
+    (root / ".claude" / "claims" / "sess-z.json").write_text(json.dumps({
+        "ticket": "T-101", "session": "sess-z", "note": "n",
+        "start_commit": subprocess.run(["git", "rev-parse", "HEAD"], cwd=root,
+                                       capture_output=True, text=True, check=True).stdout.strip(),
+        "attempts": 0, "ts": 0,
+    }))
+    (root / "src" / "a" / "DONE").write_text("verify would now pass\n")
+
+    result = _harness(root, ["close"], session="sess-z")
+    assert result.returncode == 2
+    assert "REFUSING to close T-101" in result.stdout
+    rec = json.loads((root / ".claude" / "evidence" / "T-101.json").read_text())
+    assert rec["kind"] == "superseded", "the supersede record must survive intact"
+
+
+# ---------------------------------------------------------------------------
+# 3. fail-closed on anything not positively recognised
+# ---------------------------------------------------------------------------
+def test_an_unrecognised_kind_is_never_a_receipt(tmp_path: Path) -> None:
+    """"Absence means receipt" is only safe if an unrecognised VALUE does not also mean
+    receipt. A typo'd kind, a null, or a kind from a future harness version must fail
+    CLOSED -- never `resolved`, and never `queue` either (queue would quietly invite a
+    re-claim over a record nobody has looked at)."""
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    evidence = root / ".claude" / "evidence"
+    evidence.mkdir(parents=True, exist_ok=True)
+
+    for payload in ('{"kind": "supersedded", "ticket": "T-101"}',   # typo
+                    '{"kind": null, "ticket": "T-101"}',            # null
+                    '{"kind": "abandoned", "ticket": "T-101"}',     # future kind
+                    "{not json at all"):                            # unreadable
+        (evidence / "T-101.json").write_text(payload)
+        assert _board(root)["T-101"] == "evidence-unrecognised", payload
+        refused = _harness(root, ["claim", "T-101", "retry"], session="sess-q")
+        assert refused.returncode == 1, payload
+        assert "unrecognised kind" in refused.stdout, payload
+
+        gate = _harness(root, ["hook-taskgate"], stdin=json.dumps(
+            {"tool_input": {"subject": "T-101: synthetic T-101", "status": "completed"}}))
+        assert gate.returncode == 2, f"{payload} must not satisfy the completion gate"
+
+
+def test_status_board_surfaces_superseded_and_unrecognised_records(tmp_path: Path) -> None:
+    """A record that certifies nothing and is reported as nothing is invisible."""
+    root = _superseded_pair(tmp_path)
+    result = _harness(root, ["status_board"], session=None)
+    assert result.returncode == 0
+    assert "!!  SUPERSEDED" in result.stdout
+    assert "nothing was verified" in result.stdout
+
+    (root / ".claude" / "evidence" / "T-102.json").write_text('{"kind": "weird"}')
+    result = _harness(root, ["status_board"], session=None)
+    assert result.returncode == 0, "one broken record must not take the board down"
+    assert "UNRECOGNISED EVIDENCE" in result.stdout
+
+
+# ---------------------------------------------------------------------------
+# 4. supersede is not a cheaper close
+# ---------------------------------------------------------------------------
+def test_supersede_requires_an_owned_claim(tmp_path: Path) -> None:
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    result = _harness(root, ["supersede", REASON])
+    assert result.returncode == 1
+    assert "no claim held by this session" in result.stdout
+    assert not (root / ".claude" / "evidence" / "T-101.json").exists()
+
+
+def test_supersede_requires_a_substantive_reason(tmp_path: Path) -> None:
+    """The reason is the entire content of the record: it is what reaches the human in
+    NEEDS_HUMAN.md, what renders on the board, and what every downstream claim is warned
+    with. "wontfix" is not a finding."""
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    assert _harness(root, ["claim", "T-101", "ordering note"]).returncode == 0
+
+    for thin in ("", "   ", "wontfix", "too hard"):
+        result = _harness(root, ["supersede", thin])
+        assert result.returncode == 1, thin
+        assert "REFUSING to supersede" in result.stdout, thin
+        assert not (root / ".claude" / "evidence" / "T-101.json").exists(), thin
+    # the claim is still held -- a refused supersede must not retire it
+    assert (root / ".claude" / "claims" / "sess-a.json").exists()
+
+
+def test_supersede_runs_the_same_integrity_check_as_close(tmp_path: Path) -> None:
+    """Supersede makes a commit, and a commit without a scope check is a laundering
+    route regardless of what the record beside it says. It must not become the way to
+    get out-of-scope work into history."""
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    assert _harness(root, ["claim", "T-101", "ordering note"]).returncode == 0
+    (root / "out_of_scope.txt").write_text("smuggled\n")
+
+    result = _harness(root, ["supersede", REASON])
+    assert result.returncode == 2
+    assert "INTEGRITY FAIL" in result.stdout
+    assert "out_of_scope.txt" in result.stdout
+    assert not (root / ".claude" / "evidence" / "T-101.json").exists()
+
+
+def test_supersede_reaches_the_human_and_retires_the_claim(tmp_path: Path) -> None:
+    root = _superseded_pair(tmp_path)
+    needs_human = (root / ".claude" / "NEEDS_HUMAN.md").read_text()
+    assert "T-101 SUPERSEDED" in needs_human
+    assert REASON in needs_human
+    assert "NOT a receipt" in needs_human
+    assert not (root / ".claude" / "claims" / "sess-a.json").exists()
+
+
+def test_supersede_does_not_overwrite_an_existing_receipt(tmp_path: Path) -> None:
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    assert _harness(root, ["claim", "T-101", "ordering note"]).returncode == 0
+    assert _harness(root, ["close"]).returncode == 0
+    # Fabricate a second claim on the already-resolved ticket.
+    (root / ".claude" / "claims" / "sess-z.json").write_text(json.dumps({
+        "ticket": "T-101", "session": "sess-z", "note": "n",
+        "start_commit": subprocess.run(["git", "rev-parse", "HEAD"], cwd=root,
+                                       capture_output=True, text=True, check=True).stdout.strip(),
+        "attempts": 0, "ts": 0,
+    }))
+
+    result = _harness(root, ["supersede", REASON], session="sess-z")
+    assert result.returncode == 1
+    assert "already carries a terminal record" in result.stdout
+    rec = json.loads((root / ".claude" / "evidence" / "T-101.json").read_text())
+    assert "fingerprint" in rec, "the receipt must survive intact"
+
+
+def test_the_supersede_record_is_never_agent_writable(tmp_path: Path) -> None:
+    """`.claude/evidence/**` is in ABSOLUTE, which yields to no ticket scope. A
+    superseded record is harness attestation state exactly like a receipt: an agent
+    that could edit one could rewrite its own unachievability finding."""
+    root = _superseded_pair(tmp_path)
+    result = _harness(
+        root, ["guard", "sess-b", str(root / ".claude" / "evidence" / "T-101.json")])
+    assert result.returncode == 0
+    assert result.stdout.strip().startswith("deny:")
+    assert "harness-written attestation state" in result.stdout
+
+
+def test_an_unknown_verb_is_not_a_silent_success(tmp_path: Path) -> None:
+    """Why this ships with the supersede change: before it, `claim.sh supersede "..."`
+    fell through every dispatch branch and exited 0 printing nothing -- indistinguishable
+    from having worked. A lifecycle command that does nothing must never look like one
+    that did, or the next missing verb is invisible the same way."""
+    root = _project(tmp_path, [_ticket("T-101", ["src/a/**"])], {"src/a/a.py": "a\n"})
+    result = _harness(root, ["frobnicate"])
+    assert result.returncode != 0
+    assert "unknown harness verb" in result.stdout
+    assert "supersede" in result.stdout
