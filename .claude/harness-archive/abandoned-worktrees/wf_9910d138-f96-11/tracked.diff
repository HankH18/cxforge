+def working_tree_dirty():
+    """Paths with uncommitted changes right now (staged, unstaged, untracked)."""
+    r = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True, cwd=ROOT)
+    out = []
+    for line in r.stdout.splitlines():
+        if not line.strip():
+            continue
+        p = line[3:].strip()
+        if " -> " in p:            # rename: take the destination
+            p = p.split(" -> ", 1)[1]
+        out.append(p.strip('"'))
+    return sorted(set(out))
+
