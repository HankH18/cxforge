+        "  status: APPROVED", "  status: PROPOSED_AWAITING_HUMAN_REVIEW"))
+    subprocess.run(["git", "add", "-A"], cwd=evals_project, check=True, capture_output=True)
+    subprocess.run(["git", "commit", "-q", "-m", "honest PROPOSED state"],
+                   cwd=evals_project, check=True, capture_output=True)
+    return evals_project
