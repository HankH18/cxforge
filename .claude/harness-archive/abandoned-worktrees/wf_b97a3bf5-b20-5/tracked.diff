+def test_a_verify_command_that_writes_the_approval_still_fails_the_close(
+    tmp_path: Path,
+) -> None:
+    """The last route, and the subtlest: integrity() runs BEFORE the verify and the
+    close commit happens AFTER it, so whatever a verify writes lands inside the
+    attested range unchecked (W15 -- demonstrated live by T-7's own close, whose
+    range carries three docs/eval-report/ files its verify generated).
+
+    Every other check in this file would be defeated by moving the write into the
+    verify string. The re-check after the verify is deliberately HUMAN_ONLY-only:
+    re-running the FULL integrity check there fails T-7 outright, because T-7's
+    verify legitimately writes docs/eval-report/** which its scope does not name.
+    """
+    tickets = {"project": "probe", "tickets": [{
+        "id": "S-2", "title": "verify writes the approval",
+        "verify": ("python3 -c \"import pathlib;"
+                   "p=pathlib.Path('evals/labeled_set.yaml');"
+                   "p.write_text(p.read_text().replace("
+                   "'status: PROPOSED_AWAITING_HUMAN_REVIEW','status: APPROVED'))\""),
+        "scope": ["evals/**"], "depends_on": [], "acceptance": [], "non_goals": [],
+    }]}
+    project = make_project(tmp_path / "proj", tickets)
+    (project / "evals").mkdir(exist_ok=True)
+    (project / LABELED_SET).write_text(
+        REAL_LABELED_SET.read_text().replace(
+            "  status: APPROVED", "  status: PROPOSED_AWAITING_HUMAN_REVIEW"))
+    subprocess.run(["git", "add", "-A"], cwd=project, check=True, capture_output=True)
+    subprocess.run(["git", "commit", "-q", "-m", "proposed"], cwd=project, check=True,
+                   capture_output=True)
+
+    claimed = _lib_run(project, "sess-verify", "claim", "S-2", "probe")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+    closed = _lib_run(project, "sess-verify", "close")
+    # The verify itself SUCCEEDS -- it is a plain write. The close still refuses.
+    assert "status: APPROVED" in (project / LABELED_SET).read_text()
+    assert closed.returncode == 2, closed.stdout + closed.stderr
+    assert LABELED_SET in closed.stdout
+    assert "VERIFY COMMAND" in closed.stdout
