+"""W10 — the human approval gate is not agent-authorable.
+
+WHAT WAS BROKEN (reproduced against the shipped harness before the fix, all five
+routes ALLOW/rc=0):
+
+  1. guard, no claim held        Edit evals/labeled_set.yaml  -> ALLOW
+  2. guard, holding T-7          Edit evals/labeled_set.yaml  -> ALLOW
+  3. guard, no claim held        Edit evals/report.py         -> ALLOW
+  4. Bash-write inside a T-7 window, then `harness_lib.py integrity T-7 <start>`
+                                                              -> rc 0 (clean)
+  5. Bash-write BEFORE claiming T-7, then claim                -> rc 0, the write
+     absorbed into the ticket-start commit, invisible to a check that only ever
+     diffs FORWARD from it
+
+`evals/labeled_set.yaml` was in neither ABSOLUTE nor PROTECTED, and T-7's own
+scope glob `evals/**` granted write access to the very file T-7's verify reads:
+
+    a['status']=='APPROVED' and a['approved_by'] and a['approved_date']
+
+Those three strings prove the fields are SET. An agent typing the owner's name
+and today's date produces a byte-identical pass and a byte-identical receipt.
+(.claude/NEEDS_HUMAN.md records that the real flip WAS the owner's own — the
+exposure this file addresses is the next one, not that one.)
+
+WHAT THE FIX IS, AND WHAT IT IS NOT.  harness_lib.HUMAN_ONLY covers the approval
+artifact, the trust anchor and the verifier. It is checked at THREE points, and
+the last two are the ones that matter:
+  * the Edit/Write guard  — denies, under every claim, ignoring scope entirely;
+  * cmd_claim's dirty gate — refuses to absorb them into a ticket-start commit;
+  * integrity()/cmd_close — fails the close by name, regardless of scope.
+The Bash tool is matched by NO PreToolUse hook, so route (1)-(3) can still be
+driven by `python3 -c`. The point of the last two is that doing so no longer
+ends in a receipt. That is the harness's own documented compensating control for
+the Bash hole (protocol rule 4), applied to the one file it had been omitting.
+
+The signature half (`.claude/scripts/approval_gate.py`) is what makes an approval
+an artifact an agent cannot CONSTRUCT rather than one it is merely forbidden to
+type: a detached SSH signature under a passphrase-protected key that is never
+loaded into ssh-agent. Shipped UNARMED — the anchor names no key — so it reports
+and does not refuse until the owner arms it.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from .conftest import (
+    REAL_SCOPES,
+    REPO_ROOT,
+    _assert_real_repo_untouched,
+    _subprocess_env,
+    expect,
+    make_project,
+    write_claim,
+)
+
+REAL_LABELED_SET = REPO_ROOT / "evals" / "labeled_set.yaml"
+LABELED_SET = "evals/labeled_set.yaml"
+
+# Every ticket that legitimately writes under evals/. T-21 is IN FLIGHT with
+# scope [evals/report.py, backend/tests/evals/**, docs/eval-report/**]; none of
+# these may have been narrowed by making evals/** PROTECTED.
+EVALS_WRITERS = ["T-7", "T-15", "T-21", "T-25"]
+
+
+# ---------------------------------------------------------------------------
+# Classification
+# ---------------------------------------------------------------------------
+def _matches(path: str, listname: str) -> bool:
+    """Ask the REAL harness_lib whether `path` matches one of its pattern lists.
+
+    Run as a subprocess rather than imported, following
+    test_evidence_migration.py's convention: harness_lib.py lives outside any
+    package (it is the vendored harness, excluded from ruff and unresolvable by
+    mypy), and it resolves ROOT from CLAUDE_PROJECT_DIR at import time -- so
+    importing it into the test process would bind it to whatever this process
+    happens to think the root is.
+    """
+    script = (
+        "import json,sys;"
+        "sys.path.insert(0, sys.argv[1]);"
+        "import harness_lib as h;"
+        "raw = sys.argv[3] != 'scope';"
+        "pats = getattr(h, sys.argv[3]) if raw else json.loads(sys.argv[4]);"
+        "print(json.dumps(h.match_any(sys.argv[2], pats, raw=raw)))"
+    )
+    result = subprocess.run(
+        [sys.executable, "-c", script, str(REPO_ROOT / ".claude" / "scripts"),
+         path, listname, "[]"],
+        capture_output=True, text=True, check=True, timeout=30,
+    )
+    return bool(json.loads(result.stdout))
+
+
+def _scope_matches(path: str, scope: list[str]) -> bool:
+    script = (
+        "import json,sys;"
+        "sys.path.insert(0, sys.argv[1]);"
+        "import harness_lib as h;"
+        "print(json.dumps(h.match_any(sys.argv[2], json.loads(sys.argv[3]))))"
+    )
+    result = subprocess.run(
+        [sys.executable, "-c", script, str(REPO_ROOT / ".claude" / "scripts"),
+         path, json.dumps(scope)],
+        capture_output=True, text=True, check=True, timeout=30,
+    )
+    return bool(json.loads(result.stdout))
+
+
+def test_the_approval_artifact_and_its_anchor_are_human_only() -> None:
+    """Classification, asserted directly — the guard/claim/close behaviours below
+    all key off this list, so a path silently dropping out of it would weaken all
+    three at once while each individual behavioural test still had *something* to
+    assert about the remaining paths.
+    """
+    for path in (LABELED_SET, ".claude/approval/allowed_signers",
+                 ".claude/approval/labeled_set.sig",
+                 ".claude/scripts/approval_gate.py"):
+        assert _matches(path, "HUMAN_ONLY"), path
+    # HUMAN_ONLY is a subset of ABSOLUTE (the guard reaches it via the same
+    # never-yields-to-scope branch), but NOT of HARNESS_STATE -- that distinction
+    # is exactly what makes it enforceable at close time. .claude/claims/** and
+    # .claude/evidence/** are exempt from integrity() because the harness writes
+    # them at every boundary; these are not written by anything but a human.
+    for path in (LABELED_SET, ".claude/approval/allowed_signers"):
+        assert _matches(path, "ABSOLUTE")
+        assert not _matches(path, "HARNESS_STATE")
+        assert not _matches(path, "META_ALLOW")
+
+
+def test_evals_is_protected_so_an_unclaimed_session_cannot_rewrite_the_corpus() -> None:
+    for path in ("evals/report.py", "evals/REVIEW.md", LABELED_SET):
+        assert _matches(path, "PROTECTED"), path
+    # ...and the near miss stays a near miss: PROTECTED must not have become a
+    # prefix match that swallows unrelated trees.
+    assert not _matches("eval/report.py", "PROTECTED")
+    assert not _matches("backend/evals/report.py", "PROTECTED")
+
+
