+#!/usr/bin/env python3
+"""Binds evals/labeled_set.yaml's `approval:` block to a HUMAN, not to a field value.
+
+WHY THIS EXISTS
+---------------
+The plan reserves exactly one gate for the project owner (docs/tickets.json T-7
+non_goal: "No synthetic label approval — human sign-off is external ground truth").
+T-7's verify tests that gate by reading three fields out of the very file a ticket
+in scope may write:
+
+    a['status']=='APPROVED' and a['approved_by'] and a['approved_date']
+
+Those three fields prove the fields are SET. They cannot prove a human set them —
+an agent writing `"Hank Holcomb"` and today's date produces a byte-identical pass.
+That is the standing top item in .claude/NEEDS_HUMAN.md ("with the approval
+genuine, the exposure is the *next* flip, not this one"), and it is what this file
+addresses: approval becomes an artifact the agent is STRUCTURALLY UNABLE to
+construct, rather than a string it is merely forbidden to type.
+
+THE MECHANISM, AND WHY IT IS THE ONLY ONE AVAILABLE HERE
+--------------------------------------------------------
+Measured on this machine (recon, 2026-08-15): the agent runs as the owner's own
+uid. There is no file it cannot write and no software key it cannot use — the
+launchd ssh-agent holds an unconfirmed ED25519 key IN THE AGENT'S OWN ENVIRONMENT,
+so `ssh-keygen -Y sign` and even a `%G? = G` signed git commit are one Bash call
+away, with no prompt and no touch. gpg is not installed; the attached YubiKey has
+no FIDO middleware (`ssh-keygen -t ecdsa-sk` fails: "No FIDO SecurityKeyProvider").
+
+So a mechanism binds only if satisfying it needs either a physical act at a
+hardware token or A SECRET THAT EXISTS ONLY IN THE OWNER'S HEAD and is never typed
+into an agent-visible process. This implements the second, with zero installs:
+
+  * a detached SSH signature over a canonical payload derived from the labeled set,
+  * made with an ed25519 key that is PASSPHRASE-PROTECTED and deliberately NOT
+    loaded into ssh-agent,
+  * verified with `ssh-keygen -Y verify` (present: OpenSSH_10.2p1) against an
+    allowed-signers anchor.
+
+Verified live: with full read access to the private key file but no passphrase,
+`ssh-keygen -Y sign` fails with "incorrect passphrase supplied" and writes nothing.
+That is the whole point — read access is not signing capability.
+
+HONEST LIMITS — read these before trusting this file
+----------------------------------------------------
+1. TRUST ANCHOR. `.claude/approval/allowed_signers` names the public key that
+   counts. An agent with Bash can overwrite it with its own key and re-sign. What
+   stops that from passing silently is NOT this file: it is harness_lib.HUMAN_ONLY,
+   which lists both the anchor and this script, denies Edit/Write to them under any
+   claim, and — the part Bash cannot route around — fails the close-time integrity
+   check for any ticket whose window changed them. So anchor substitution is
+   TAMPER-EVIDENT AND CLOSE-BLOCKING, not impossible. It cannot be made impossible
+   by anything living inside a repo the agent can write.
+2. This is not a gate on the FILE. It is a gate on the CLAIM the file makes. An
+   agent can still write `status: APPROVED` (via Bash — no PreToolUse matcher
+   covers Bash). What it cannot do is make that claim verify.
+3. UNARMED BY DEFAULT. With no key line in the anchor, `verify` reports
+   UNVERIFIABLE and the harness prints a notice rather than refusing anything, so
+   installing this file changes no existing behaviour. Arming is one command by the
+   owner — see .claude/approval/README.md.
+
+EXIT CODES (`verify`)
+  0  approved AND the signature verifies against the anchor
+  3  the file DECLARES approval that cannot be verified (unarmed, unsigned,
+     stale, or forged) — the interesting state
+  4  the file declares no approval (honest PROPOSED state)
+  2  infra: file unreadable, ssh-keygen missing/erroring
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import re
+import subprocess
+import sys
+
+ROOT = os.environ.get("CLAUDE_PROJECT_DIR") or subprocess.run(
+    ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
+
+LABELED_SET = "evals/labeled_set.yaml"
+ANCHOR = os.path.join(".claude", "approval", "allowed_signers")
+SIGNATURE = os.path.join(".claude", "approval", "labeled_set.sig")
+NAMESPACE = "cxforge-label-approval"
+PAYLOAD_VERSION = "cxforge-label-approval v1"
+
+OK, INFRA, UNVERIFIED, NOT_APPROVED = 0, 2, 3, 4
+
+
+def _abs(rel: str) -> str:
+    return os.path.join(ROOT, rel)
+
+
+# ---------------------------------------------------------------------------
+# Parsing — deliberately WITHOUT pyyaml.
+# harness_lib.py's whole contract is "python3 + git, no third-party imports"
+# (that is why the lifecycle moved into it from jq-based shell in the first
+# place), and the close path calls this script. A gate that only runs when an
+# optional dependency happens to be installed is a gate that silently stops
+# running. The approval block is a flat, fixed, three-field mapping; a targeted
+# reader is both sufficient and one less thing that can be absent.
+# ---------------------------------------------------------------------------
+_FIELD = re.compile(r"^\s+(status|approved_by|approved_date)\s*:\s*(.*?)\s*$")
+
+
+def split_approval_block(text: str) -> tuple[list[str], list[str]]:
+    """(approval-block lines, everything-else lines).
+
+    The block runs from the line beginning `approval:` at column 0 up to the next
+    non-blank line that also begins at column 0 (the next top-level YAML key, or a
+    column-0 comment — the real file's in-block comments are all indented, and an
+    unindented one inside the block would merely end the block early, which fails
+    CLOSED: fewer fields parsed, approval reads as absent).
+    """
+    lines = text.splitlines(keepends=True)
+    start = next((i for i, ln in enumerate(lines) if ln.startswith("approval:")), None)
+    if start is None:
+        return [], lines
+    end = len(lines)
+    for j in range(start + 1, len(lines)):
+        ln = lines[j]
+        if ln.strip() and not ln[0].isspace():
+            end = j
+            break
+    return lines[start:end], lines[:start] + lines[end:]
+
+
+def approval_fields(block: list[str]) -> dict[str, str]:
+    out: dict[str, str] = {}
+    for ln in block:
+        m = _FIELD.match(ln)
+        if m:
+            val = m.group(2).strip()
+            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
+                val = val[1:-1]
+            out.setdefault(m.group(1), val)
+    return out
+
+
+def canonical_payload(text: str) -> tuple[bytes, dict[str, str]]:
+    """The exact bytes a human signs.
+
+    Covers BOTH halves, and that pairing is the point:
+      * body_sha256 — the labels themselves, minus the approval block. Re-label a
+        ticket after sign-off and the old signature stops verifying.
+      * the three approval fields — so the approval cannot be lifted off one
+        (name, date, status) and re-used under another.
+    Plain text, not a digest blob, so the owner can read what they are signing.
+    """
+    block, rest = split_approval_block(text)
+    fields = approval_fields(block)
+    body = hashlib.sha256("".join(rest).encode()).hexdigest()
+    payload = (
+        f"{PAYLOAD_VERSION}\n"
+        f"file: {LABELED_SET}\n"
+        f"body_sha256: {body}\n"
+        f"status: {fields.get('status', '')}\n"
+        f"approved_by: {fields.get('approved_by', '')}\n"
+        f"approved_date: {fields.get('approved_date', '')}\n"
+    )
+    return payload.encode(), fields
+
+
+# ---------------------------------------------------------------------------
+# Anchor
+# ---------------------------------------------------------------------------
+def anchor_principals() -> list[str]:
+    """Principals named by non-comment lines in the allowed-signers anchor.
+
+    Empty list == UNARMED. An anchor file that exists but holds only comments is
+    unarmed too: a comment is not a key.
+    """
+    path = _abs(ANCHOR)
+    if not os.path.exists(path):
+        return []
+    out = []
+    try:
+        with open(path) as fh:
+            for ln in fh:
+                ln = ln.strip()
+                if not ln or ln.startswith("#"):
+                    continue
+                parts = ln.split()
+                if len(parts) >= 3:
+                    out.append(parts[0])
+    except OSError:
+        return []
+    return out
+
+
+def is_armed() -> bool:
+    return bool(anchor_principals())
+
+
+# ---------------------------------------------------------------------------
+# Verification
+# ---------------------------------------------------------------------------
+def verify() -> tuple[int, str]:
+    try:
+        with open(_abs(LABELED_SET)) as fh:
+            text = fh.read()
+    except OSError as e:
+        return INFRA, f"cannot read {LABELED_SET} ({e})"
+
+    payload, fields = canonical_payload(text)
+    declared = (
+        fields.get("status") == "APPROVED"
+        and bool(fields.get("approved_by"))
+        and bool(fields.get("approved_date"))
+    )
+    if not declared:
+        return NOT_APPROVED, (
+            f"{LABELED_SET} declares no approval (status={fields.get('status') or '<absent>'!r}) "
+            "— the honest un-signed-off state."
+        )
+
+    principals = anchor_principals()
+    if not principals:
+        return UNVERIFIED, (
+            f"{LABELED_SET} declares status: APPROVED by {fields.get('approved_by')!r} on "
+            f"{fields.get('approved_date')!r}, but {ANCHOR} names no key, so NOTHING IN THIS "
+            "REPO CAN TELL A HUMAN APPROVAL FROM AN AGENT-WRITTEN ONE. The three fields are "
+            "exactly what a coding agent can type. Arm the gate: see .claude/approval/README.md."
+        )
+    if not os.path.exists(_abs(SIGNATURE)):
+        return UNVERIFIED, (
+            f"{LABELED_SET} declares status: APPROVED but {SIGNATURE} does not exist. The "
+            "anchor is armed, so an approval without a signature is not an approval."
+        )
+
+    errors = []
+    for principal in principals:
+        try:
+            r = subprocess.run(
+                ["ssh-keygen", "-Y", "verify", "-f", _abs(ANCHOR), "-I", principal,
+                 "-n", NAMESPACE, "-s", _abs(SIGNATURE)],
+                input=payload, capture_output=True, timeout=30,
+            )
+        except FileNotFoundError:
+            return INFRA, ("ssh-keygen is not on PATH, so the approval signature cannot be "
+                           "checked at all. Refusing to report an unchecked approval as good.")
+        except Exception as e:  # timeout, OSError...
+            return INFRA, f"ssh-keygen could not run ({e}); approval left unverified."
+        if r.returncode == 0:
+            return OK, (f"approval on {LABELED_SET} VERIFIED: signature by {principal} over "
+                        f"the current labels and the current approval fields.")
+        errors.append(f"{principal}: {(r.stderr or b'').decode(errors='replace').strip()[:160]}")
+
+    return UNVERIFIED, (
+        f"{LABELED_SET} declares status: APPROVED by {fields.get('approved_by')!r}, but the "
+        f"signature in {SIGNATURE} does NOT verify against {ANCHOR}. Either the labels or the "
+        "approval fields changed after signing, or the signature was not made by the owner's "
+        "key. Details: " + " | ".join(errors)
+    )
+
+
+def main() -> int:
+    cmd = sys.argv[1] if len(sys.argv) > 1 else "verify"
+    if cmd == "payload":
+        # What the owner signs. Printed, never written, so nothing here can be
+        # mistaken for the signature itself.
+        try:
+            with open(_abs(LABELED_SET)) as fh:
+                text = fh.read()
+        except OSError as e:
+            sys.stderr.write(f"cannot read {LABELED_SET} ({e})\n")
+            return INFRA
+        sys.stdout.buffer.write(canonical_payload(text)[0])
+        return 0
+    if cmd == "armed":
+        armed = is_armed()
+        print("armed: " + (", ".join(anchor_principals()) if armed else "NO — anchor names no key"))
+        return 0 if armed else 1
+    if cmd in ("verify", "status"):
+        rc, msg = verify()
+        print(msg)
+        # `status` is the advisory form the close path uses: it reports, it never
+        # decides. Keeping the decision in `verify` alone means a caller cannot
+        # accidentally get a pass out of the reporting entry point.
+        return 0 if cmd == "status" else rc
+    sys.stderr.write(f"usage: approval_gate.py [verify|status|payload|armed]\n")
+    return INFRA
+
+
+if __name__ == "__main__":
+    sys.exit(main())
