+    assert LABELED_SET in closed.stdout
+    assert not (proposed_project / ".claude" / "evidence" / "T-7.json").exists()
+    # The materiality rule's usual remedy must NOT be offered here: for a genuine
+    # human approval `git reset --hard <start>` would destroy the one artifact in
+    # the repo that cannot be regenerated by re-running anything.
