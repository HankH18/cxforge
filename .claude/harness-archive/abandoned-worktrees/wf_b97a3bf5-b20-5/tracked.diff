+# ---------------------------------------------------------------------------
+# The signature: an approval an agent cannot construct
+# ---------------------------------------------------------------------------
+GATE = ".claude/scripts/approval_gate.py"
+NAMESPACE = "cxforge-label-approval"
+
+
+def _gate(project: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [sys.executable, str(project / GATE), *args],
+        capture_output=True, text=True, env=_subprocess_env(project), cwd=project, timeout=60,
+    )
+
+
+def _arm(project: Path, tmp_path: Path) -> Path:
+    key = tmp_path / "approval_key"
+    subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "pp", "-f", str(key), "-q"],
+                   check=True, capture_output=True)
+    pub = (tmp_path / "approval_key.pub").read_text().split()
+    anchor = project / ".claude" / "approval" / "allowed_signers"
+    anchor.parent.mkdir(parents=True, exist_ok=True)
+    with anchor.open("a") as fh:
+        fh.write(f"hank@cxforge {pub[0]} {pub[1]}\n")
+    return key
+
+
+def _sign(project: Path, tmp_path: Path, key: Path) -> None:
+    payload = _gate(project, "payload")
+    assert payload.returncode == 0, payload.stderr
+    blob = tmp_path / "payload.txt"
+    blob.write_text(payload.stdout)
+    env = dict(os.environ)
+    env["SSH_ASKPASS_REQUIRE"] = "never"
+    subprocess.run(["ssh-keygen", "-Y", "sign", "-f", str(key), "-n", NAMESPACE,
+                    "-P", "pp", str(blob)], check=True, capture_output=True, env=env)
+    shutil.copyfile(str(blob) + ".sig", project / ".claude" / "approval" / "labeled_set.sig")
+
+
+def test_the_gate_ships_unarmed_so_installing_it_refuses_nothing() -> None:
+    """The committed anchor must name no key. An armed anchor landed by an agent
+    would be an agent-chosen trust root -- and would also turn the suite red
+    while the owner is away, which is the reason the corroboration test that was
+    proposed in NEEDS_HUMAN.md was deliberately not landed either.
+    """
+    anchor = REPO_ROOT / ".claude" / "approval" / "allowed_signers"
+    assert anchor.exists(), "the anchor slot must exist so arming is an append, not a guess"
+    keys = [ln for ln in anchor.read_text().splitlines()
+            if ln.strip() and not ln.strip().startswith("#")]
+    assert keys == [], f"the committed anchor names a key: {keys}"
+
