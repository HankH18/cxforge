+    subprocess.run(["git", "commit", "-q", "-m", "seed"], cwd=project, check=True,
+                   capture_output=True)
+
+    claimed = _lib_run(project, "sess-gen", "claim", "S-3", "probe")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+    (project / "src" / "a.py").write_text("x = 2\n")
+    closed = _lib_run(project, "sess-gen", "close")
+    assert closed.returncode == 0, closed.stdout + closed.stderr
+    assert (project / ".claude" / "evidence" / "S-3.json").exists()
+
+
+def test_unarmed_the_same_close_succeeds_but_says_the_approval_is_unverified(
+    tmp_path: Path,
+) -> None:
+    """Installing the gate must not brick a build whose owner has not armed it.
+    The receipt is minted; the caveat is spoken at the moment it is minted, since
+    the receipt's own key set is fixed by test_claim_format and cannot carry it.
+    """
+    tickets = {"project": "probe", "tickets": [{
+        "id": "S-1", "title": "gates on the human approval",
+        "verify": ("python3 -c \"import sys;"
+                   "sys.exit(0 if 'status: APPROVED' in "
+                   "open('evals/labeled_set.yaml').read() else 1)\""),
+        "scope": ["src/**"], "depends_on": [], "acceptance": [], "non_goals": [],
+    }]}
+    project = make_project(tmp_path / "proj", tickets)
+    (project / "evals").mkdir(exist_ok=True)
+    shutil.copyfile(REAL_LABELED_SET, project / LABELED_SET)
+    (project / "src").mkdir(exist_ok=True)
+    (project / "src" / "a.py").write_text("x = 1\n")
+    subprocess.run(["git", "add", "-A"], cwd=project, check=True, capture_output=True)
+    subprocess.run(["git", "commit", "-q", "-m", "unarmed"], cwd=project, check=True,
+                   capture_output=True)
+
+    claimed = _lib_run(project, "sess-unarmed", "claim", "S-1", "probe")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+    (project / "src" / "a.py").write_text("x = 2\n")
+    closed = _lib_run(project, "sess-unarmed", "close")
+    assert closed.returncode == 0, closed.stdout + closed.stderr
+    assert (project / ".claude" / "evidence" / "S-1.json").exists()
+    assert "UNVERIFIED APPROVAL" in closed.stdout
