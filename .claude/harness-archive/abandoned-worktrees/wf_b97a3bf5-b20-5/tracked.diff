+def test_an_agent_cannot_sign_without_the_passphrase(tmp_path: Path) -> None:
+    """The binding property, asserted rather than assumed.
+
+    The agent runs as the owner's uid: it can READ the private key file. That is
+    the whole threat model here -- everything else on this machine (the launchd
+    ssh-agent key, git commit signing) is forgeable in one call precisely because
+    no secret is required. This proves read access is not signing capability.
+    """
+    key = tmp_path / "k"
+    subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "a-secret-only-hank-knows",
+                    "-f", str(key), "-q"], check=True, capture_output=True)
+    assert key.read_bytes(), "the agent can read the key file"
+
+    blob = tmp_path / "forged.txt"
+    blob.write_text("status: APPROVED\n")
+    env = dict(os.environ)
+    env["SSH_ASKPASS_REQUIRE"] = "never"
+    env.pop("SSH_ASKPASS", None)
+    env.pop("DISPLAY", None)
+    result = subprocess.run(["ssh-keygen", "-Y", "sign", "-f", str(key), "-n", NAMESPACE,
+                             str(blob)], capture_output=True, text=True, env=env,
+                            stdin=subprocess.DEVNULL, timeout=30)
+    assert result.returncode != 0
+    assert not (tmp_path / "forged.txt.sig").exists()
+
