+# ---------------------------------------------------------------------------
+# Lifecycle: claim-time and close-time, i.e. the half Bash cannot route around
+# ---------------------------------------------------------------------------
+def _lib_run(project: Path, session: str, *args: str) -> subprocess.CompletedProcess[str]:
+    env = _subprocess_env(project, {"CLAUDE_CODE_SESSION_ID": session})
+    result = subprocess.run(
+        [sys.executable, str(project / ".claude" / "scripts" / "harness_lib.py"), *args],
+        capture_output=True, text=True, env=env, cwd=project, timeout=120,
+    )
+    _assert_real_repo_untouched()
+    return result
+
+
+def _forge_via_bash(project: Path) -> None:
+    """Write the approval WITHOUT the Edit tool. No PreToolUse matcher covers
+    Bash -- this is the route the guard genuinely cannot see, and the whole
+    reason the claim/close checks exist.
+    """
+    path = project / LABELED_SET
+    subprocess.run(
+        [sys.executable, "-c",
+         "import sys,pathlib;p=pathlib.Path(sys.argv[1]);"
+         "p.write_text(p.read_text().replace('status: PROPOSED_AWAITING_HUMAN_REVIEW',"
+         "'status: APPROVED'))", str(path)],
+        check=True, capture_output=True,
+    )
+    assert "status: APPROVED" in path.read_text()
+
