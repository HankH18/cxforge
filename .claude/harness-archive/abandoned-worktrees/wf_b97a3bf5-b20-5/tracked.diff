+def test_armed_a_ticket_whose_verify_reads_the_approval_cannot_close_unsigned(
+    tmp_path: Path,
+) -> None:
+    """W16's closed loop, as far as a non-plan file can reach it.
+
+    T-7's verify tests exactly the three fields a scoped ticket could write. Once
+    the anchor is armed, a ticket whose verify READS the approval artifact may not
+    mint a receipt while that approval is unattributable -- the verify itself
+    still passes, which is the point: the gate the plan relies on proves nothing,
+    so a second one has to sit behind it.
+
+    Trigger is derived from the plan text (does the verify string name the
+    artifact), not hardcoded to T-7, so a later ticket gating on the same file is
+    covered without editing harness_lib.py.
+    """
+    tickets = {"project": "probe", "tickets": [{
+        "id": "S-1", "title": "gates on the human approval",
+        "verify": ("python3 -c \"import sys;"
+                   "sys.exit(0 if 'status: APPROVED' in "
+                   "open('evals/labeled_set.yaml').read() else 1)\""),
+        "scope": ["src/**"], "depends_on": [], "acceptance": [], "non_goals": [],
+    }]}
+    project = make_project(tmp_path / "proj", tickets)
+    (project / "evals").mkdir(exist_ok=True)
+    shutil.copyfile(REAL_LABELED_SET, project / LABELED_SET)
+    (project / "src").mkdir(exist_ok=True)
+    (project / "src" / "a.py").write_text("x = 1\n")
+    _arm(project, tmp_path)
+    subprocess.run(["git", "add", "-A"], cwd=project, check=True, capture_output=True)
+    subprocess.run(["git", "commit", "-q", "-m", "armed"], cwd=project, check=True,
+                   capture_output=True)
+
+    claimed = _lib_run(project, "sess-w16", "claim", "S-1", "probe")
+    assert claimed.returncode == 0, claimed.stdout + claimed.stderr
+    (project / "src" / "a.py").write_text("x = 2\n")
+
+    closed = _lib_run(project, "sess-w16", "close")
+    assert closed.returncode == 2, closed.stdout + closed.stderr
+    assert "APPROVAL NOT ATTRIBUTABLE" in closed.stdout
+    assert not (project / ".claude" / "evidence" / "S-1.json").exists()
+
+    # ...and the documented remedy actually works. Signing is a HUMAN_ONLY write,
+    # so it may not happen inside the window either -- doing it here refuses the
+    # close a second time, on the .sig rather than on the approval. The message
+    # tells the session to release, land the sign-off on its own, and re-claim;
+    # this walks exactly that, which is the only way the gate is escapable at all.
+    released = _lib_run(project, "sess-w16", "release", "human approval landed mid-ticket")
+    assert released.returncode == 0, released.stdout + released.stderr
+    _sign(project, tmp_path, tmp_path / "approval_key")
+    subprocess.run(["git", "add", "-A"], cwd=project, check=True, capture_output=True)
+    subprocess.run(["git", "commit", "-q", "-m", "owner: sign off on the labeled set"],
+                   cwd=project, check=True, capture_output=True)
+
+    reclaimed = _lib_run(project, "sess-w16", "claim", "S-1", "probe")
+    assert reclaimed.returncode == 0, reclaimed.stdout + reclaimed.stderr
+    (project / "src" / "a.py").write_text("x = 3\n")
+    reclosed = _lib_run(project, "sess-w16", "close")
+    assert reclosed.returncode == 0, reclosed.stdout + reclosed.stderr
+    assert (project / ".claude" / "evidence" / "S-1.json").exists()
+
